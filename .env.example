# Slack app-level token (connections:write) for Socket Mode
SLACK_APP_TOKEN=xapp-...
# Bot token
SLACK_BOT_TOKEN=xoxb-...
# Comma-separated Slack user IDs allowed to approve. Empty means anyone in the channel.
SLACK_APPROVER_IDS=

# Cloudflare API token with Pages: Edit, and the account id, for preview deployments.
# The Pages project named in the profile is created on the first deploy.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Site profile under profiles/. Defaults to connectmachine.
RANKSMITH_PROFILE=connectmachine
# Local checkout of the site repo. Overrides repo.path in the profile.
# RANKSMITH_REPO_PATH=
# State, worktrees and logs. Defaults to ~/.ranksmith
# RANKSMITH_HOME=
