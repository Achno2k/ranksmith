{
  "id": "connectmachine",
  "jobPrefix": "CM",
  "repo": {
    "path": "/Users/amansingh/LambdaTest/website-v2",
    "baseRemote": "upstream",
    "baseBranch": "main",
    "pushRemote": "origin",
    "pullRequestRepo": "connectmachine/website-v2",
    "branchPrefix": "feat/seo-"
  },
  "commands": {
    "install": "npm ci",
    "checks": ["npm run check", "npm run build", "npm run parity"],
    "preview": "npm run preview"
  },
  "budgets": {
    "webSearches": 30,
    "competitorPages": 10,
    "ahrefsOperations": 3,
    "marketing": {
      "webSearches": 60,
      "pagesFetched": 25
    }
  },
  "phases": {
    "research": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 1500000,
      "skill": "connectmachine-seo-content"
    },
    "research_revision": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 1500000,
      "skill": "connectmachine-seo-content"
    },
    "content": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 2400000,
      "skill": "connectmachine-seo-content"
    },
    "content_revision": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 2400000,
      "skill": "connectmachine-seo-content"
    },
    "marketing": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 1800000,
      "skill": "connectmachine-marketing-opportunities"
    },
    "marketing_revision": {
      "backend": "claude",
      "model": "claude-opus-5",
      "timeoutMs": 1800000,
      "skill": "connectmachine-marketing-opportunities"
    }
  }
